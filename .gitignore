# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — NEVER commit secrets or PHI
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# audit logs may contain PHI access records — keep out of git
/logs
*.audit.log

# typescript
*.tsbuildinfo

# editor
.vscode/
.idea/

# Real ExtendedReach exports contain PHI — never commit them.
# /data/exports is the working directory for real downloads and stays ignored.
# Both extensions: most report views export Excel, but Compliance Tracking and
# Reports Completed by Date arrive as CSV.
#
# /data/demo holds the de-identified set that ships with the repo and powers
# the public demo. It is the ONLY place a workbook may be committed, and only
# after `npm run deidentify` has been run over the whole set.
/data/exports
*.xlsx
*.csv
!/data/demo/*.xlsx

# saved browser session for the exporter — an authenticated credential
.er-session.json
__pycache__/
