# ---------------------------------------------------------------------------
# milli — environment template. Copy to `.env.local` and fill in real values.
# NEVER commit `.env.local`. NEVER put real PHI or secrets in this file.
# ---------------------------------------------------------------------------

# Data source mode:
#   "mock" -> uses local fixture data (no external calls). Default for dev.
#   "zoho" -> queries Zoho Analytics live (requires the vars below + a signed BAA).
DATA_SOURCE=mock

# --- Zoho Analytics (ExtendedReach data tap) --------------------------------
# Confirm these in Phase 0. Zoho Analytics exposes a REST/Data API; the exact
# workspace/view names depend on how ExtendedReach's export is configured.
ZOHO_ANALYTICS_BASE_URL=https://analyticsapi.zoho.com
ZOHO_ANALYTICS_ORG_ID=
ZOHO_ANALYTICS_WORKSPACE_ID=
# OAuth: exchange the refresh token for short-lived access tokens server-side.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com

# --- Auth / session ---------------------------------------------------------
# Dev-only mock auth uses this to sign the session cookie. In production,
# replace the mock provider with a BAA-capable IdP (WorkOS, AWS Cognito, etc.).
AUTH_SESSION_SECRET=change-me-in-local-only-do-not-commit

# --- Audit logging ----------------------------------------------------------
# Where PHI-access audit events are written. Use a durable, tamper-evident
# sink in production (e.g. a WORM bucket / SIEM). "stdout" is dev default.
AUDIT_SINK=stdout

# --- ExtendedReach exports (the intended production data path) --------------
# The agency declined the Zoho feed and the system audit found it unnecessary:
# every metric the dashboard needs is reachable via one-click Excel exports.
# See docs/extendedreach-audit.md.
#
# Set DATA_SOURCE=exports to read the workbooks that
# `scripts/export-extendedreach.mjs` pulls out of ExtendedReach.

# Sign-in page for your ExtendedReach tenant.
ER_BASE_URL=
ER_USERNAME=
ER_PASSWORD=

# Where exported workbooks land, and where the app reads them from.
# Gitignored — these files contain PHI.
ER_EXPORT_DIR=./data/exports

# Saved authenticated browser session, created by `--login`. Treat as a
# credential: gitignored, never share, re-create when it expires.
ER_SESSION_FILE=./.er-session.json

# Optional. If you know the URL pattern for a report view code, set it and the
# exporter navigates directly instead of walking menus, e.g.
#   ER_REPORT_URL_TEMPLATE=/reports/view?id={view}
ER_REPORT_URL_TEMPLATE=

# Per-navigation timeout for the exporter.
ER_NAV_TIMEOUT_MS=45000

# Overdue items older than this are treated as abandoned records rather than
# live work. The audit found ~half of 1,351 past-due items open since 2020-2023.
# Confirm with the exec team before this figure drives any decision.
ER_ABANDONED_AFTER_DAYS=365
