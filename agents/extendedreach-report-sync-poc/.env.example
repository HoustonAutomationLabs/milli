# extendedreach-report-sync-poc — copy to .env and fill in.
#
# .env is gitignored. Never commit a filled-in copy, and never paste real
# values into chat, a commit message, or a pull request.
#
# Every value marked TODO must be supplied before the tool can run against
# the live portal. Until they are, the run is not expected to work.

# ---------------------------------------------------------------------------
# ExtendedReach
# ---------------------------------------------------------------------------

# TODO(operator): the portal host you are authorised to use.
EXTENDEDREACH_BASE_URL=https://TODO.example-extendedreach-host.com

# The single report this POC exports. Used in filenames and the run key.
# REPORT_SLUG is optional. Leave it blank to run every enabled report.
# Set it only to name a default for single-report commands.
REPORT_SLUG=

# Path to the workflow file describing navigation, filters and the export
# control. Copy config/workflow.example.json to config/workflow.json first.
WORKFLOW_FILE=./config/workflow.json

# Optional: a direct report URL overrides the workflow file's navigation.
# TODO(operator): paste the exact URL of the one report you are authorised to
# export, taken from the address bar with the report open.
# EXTENDEDREACH_REPORT_URL=

# ---------------------------------------------------------------------------
# Paths — ALL of these must live OUTSIDE this git repository.
# The tool refuses to start if any of them resolves inside the repo.
# ---------------------------------------------------------------------------

# Persistent Chromium profile. Holds the authenticated session: treat as a
# credential. Created on first run.
BROWSER_PROFILE_DIR=/Users/TODO_YOU/er-sync/profile

# Where downloads land. Contains PHI once real reports are exported.
DOWNLOAD_DIR=/Users/TODO_YOU/er-sync/downloads

# Operational logs (redacted, but still record when PHI moved).
LOG_DIR=/Users/TODO_YOU/er-sync/logs

# Failure screenshots. Opt-in; see SCREENSHOT_ON_FAILURE below.
SCREENSHOT_DIR=/Users/TODO_YOU/er-sync/screenshots

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

# Anything smaller than this is treated as a failed or empty export.
MIN_FILE_BYTES=1024

# Extensions the tool will accept. Narrow this to what your report emits.
ALLOWED_EXTENSIONS=csv,xlsx,xls,pdf

# A FALLBACK only, used by reports that declare no columns of their own.
#
# With more than one report, put the columns in config/workflow.json under each
# report's "validation.expected_csv_headers" instead: nine reports have nine
# different column sets, and one global list would be wrong for eight of them.
# Header names are column labels, not case data, so they are safe to put there.
EXPECTED_CSV_HEADERS=

# Some ExtendedReach CSV exports are Windows-1252, not UTF-8. The reader tries
# each of these in order when reading the header row.
CSV_ENCODINGS=utf-8-sig,cp1252

# ---------------------------------------------------------------------------
# Report filters — non-sensitive only.
#
# Values are rejected unless they match ^[A-Za-z0-9 _./:-]{1,64}$ . That rule
# exists to stop a person's name being typed into a portal search box by this
# tool. Do not widen it.
# ---------------------------------------------------------------------------

# TODO(operator): the filter values your workflow file refers to by name.
# REPORT_FILTER_DATE_RANGE=Last 30 Days
# REPORT_FILTER_PROGRAM=Foster Care

# ---------------------------------------------------------------------------
# Google Drive
#
# WARNING: consumer Google accounts (gmail.com) are NOT covered by a Google
# BAA. Uploading a real ExtendedReach export to a personal Drive discloses
# PHI to a party with no business associate agreement. Point this at a folder
# in a Workspace tenant whose admin has accepted the BAA, or keep it pointed
# at de-identified files only.
# ---------------------------------------------------------------------------

# TODO(operator): the destination folder ID, from the Drive folder URL after
# /folders/ . Every report goes here unless it names its own folder via
# "drive_folder_id_env" in the workflow file.
GOOGLE_DRIVE_FOLDER_ID=TODO_DRIVE_FOLDER_ID

# Optional per-report destinations. Name these from the workflow file with
# "drive_folder_id_env": "DRIVE_FOLDER_OPEN_BEDS".
# DRIVE_FOLDER_OPEN_BEDS=

# OAuth desktop-client credentials, downloaded from Google Cloud Console.
# Must live outside the repository.
GOOGLE_CREDENTIALS_FILE=/Users/TODO_YOU/er-sync/credentials.json

# Written on first authentication. Also a credential.
GOOGLE_TOKEN_FILE=/Users/TODO_YOU/er-sync/token.json

# drive.file is least privilege: this app can only see files it created, which
# is all the duplicate check needs. If your folder rejects uploads under it,
# see the README before widening to the full drive scope.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Screenshots are off by default. When on, one is captured ONLY if the page is
# on a surface the workflow file marks screenshot-safe (a login or error page).
# On any other page the tool records a redacted note instead of an image.
SCREENSHOT_ON_FAILURE=false

# Seconds to wait for a human to finish sign-in and MFA in headed mode.
LOGIN_WAIT_SECONDS=300

NAV_TIMEOUT_MS=45000
DOWNLOAD_TIMEOUT_MS=120000

# Extra literal strings to scrub from every log line, comma-separated.
# Add the agency name, worker surnames, or anything else that must never
# appear in a log file.
# REDACT_TERMS=

# Optional local schedule used by `--schedule`. Cron fields: m h dom mon dow.
# TODO(operator): pick the time. 18:00 daily shown.
SCHEDULE_CRON=0 18 * * *
